/target/
**/*.rs.bk
.DS_Store
.train-worktrees/
src-tauri/gen/
src-tauri/target/

ui/node_modules/
ui/dist/
ui/.svelte-kit/

# Python capture helpers
**/__pycache__/
*.py[cod]

# ---------------------------------------------------------------- local / private
# Bellman's RUNTIME data never lives here — timers.db, logs/, slots/ and config.json
# live in the per-OS data dir (~/.bellman on Linux). Nothing you schedule, and no
# command a timer runs, is ever in this repo. See docs/LOCAL.md.
#
# These patterns are for LOCAL CODE you don't want published: private integrations,
# machine-specific scripts, experiments. Anything matching stays on your disk.
/local/
*.local
*.local.*
.env
.env.*
!.env.example
secrets.*
!secrets.example.*

# Staged CLI sidecars (regenerated by scripts/stage_cli_sidecar.sh)
src-tauri/binaries/bellman-*

# Standalone helper build dir
helpers/macos-wake-daemon/target/
